<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content="Baztit Tech — Ready-made solutions. Every tool is a real shipped project. Buy as-is or adapt.">
  <meta name="theme-color" content="#0C0C0E">
  <title>Ready-Made Solutions — Baztit Tech</title>
  <!-- Open Graph -->
  <meta property="og:title" content="Ready-Made Solutions — Baztit Tech">
  <meta property="og:description" content="Every tool in our library is a real shipped project. Buy as-is or with customization.">
  <meta property="og:type" content="website">
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('partials/header', { baseUrl: '/' }) %>

  <main>
    <section id="solutions-hero" aria-label="Solutions hero">
      <h1>Ready-Made Solutions — Take It & Adapt</h1>
      <p class="hero-sub">Every tool in our library is a real shipped project, tested in production. Buy as-is or with customization — faster and cheaper than building from scratch.</p>
    </section>

    <section id="solutions-filter" aria-label="Filter solutions">
      <div class="filter-pills">
        <button type="button" class="filter-pill active" data-category="all">All</button>
        <button type="button" class="filter-pill" data-category="ai-agents">AI Agents</button>
        <button type="button" class="filter-pill" data-category="crm">CRM</button>
        <button type="button" class="filter-pill" data-category="erp">ERP / Warehouse</button>
        <button type="button" class="filter-pill" data-category="analytics">Analytics</button>
        <button type="button" class="filter-pill" data-category="bots">Bots</button>
        <button type="button" class="filter-pill" data-category="integrations">Integrations</button>
      </div>
    </section>

    <section id="solutions-grid" aria-labelledby="solutions-grid-heading">
      <h2 id="solutions-grid-heading" class="sr-only">Solutions catalog</h2>
      <div class="solutions-cards">
        <article class="solution-catalog-card glass-card" data-category="ai-agents" data-modal-title="AI Sales & Lead Qualification Agent" data-modal-body="<p>Automate communication with leads and candidates across sales, support, and recruiting.</p><p>Not a chatbot. A digital employee — understands free text, qualifies leads, pushes data to CRM, moves clients through the funnel. Works with product docs and images for accurate answers.</p><p>Live and stable in production. Response time: seconds. Manager workload reduced. Lost leads minimized — without adding headcount.</p>" data-modal-price="from $500">
          <span class="card-icon">🤖</span>
          <span class="card-category">AI Agents</span>
          <h3>AI Sales & Lead Qualification Agent</h3>
          <p>Lead qualification, Q&A, CRM push. 24/7. A digital employee that understands free text and moves clients through the funnel.</p>
          <span class="card-price">from $500</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
        <article class="solution-catalog-card glass-card" data-category="crm" data-modal-title="CRM for Trade & Delivery (CIS)" data-modal-body="<p>Logistics CRM for trade and delivery: documents, tracking, courier integrations.</p><p>Automate shipment processing, document generation and tracking. Auto-generates transport docs, tracks statuses, integrates with couriers. Ready-made for CIS logistics market.</p><p>Available for $500 one-time. No monthly fees.</p>" data-modal-price="$500 one-time">
          <span class="card-icon">📦</span>
          <span class="card-category">CRM</span>
          <h3>CRM for Trade & Delivery (CIS)</h3>
          <p>Document automation, tracking, courier integrations. Auto-generates transport docs, tracks statuses.</p>
          <span class="card-price">$500 one-time</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
        <article class="solution-catalog-card glass-card" data-category="erp" data-modal-title="Production & Warehouse Tracking System" data-modal-body="<p>Track product status through manufacturing — line load, warehouse movement, order reservation.</p><p>Full production and inventory system from scratch. Integrated with client's existing workflow.</p><p>Cost $2,000 · Delivered in 2 weeks · Competing quotes: $50,000+ · Savings: 96%</p>" data-modal-price="from $1,500">
          <span class="card-icon">📋</span>
          <span class="card-category">ERP / Warehouse</span>
          <h3>Production & Warehouse Tracking System</h3>
          <p>Full production and inventory system. Track line load, warehouse movement, order reservation.</p>
          <span class="card-price">from $1,500</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
        <article class="solution-catalog-card glass-card" data-category="analytics" data-modal-title="Auto Analytics Dashboard" data-modal-body="<p>Revenue, clients, funnel — auto-updated from your data sources.</p><p>Connect to CRM, spreadsheets, or APIs. Real-time dashboards without manual Excel work.</p>" data-modal-price="from $500">
          <span class="card-icon">📊</span>
          <span class="card-category">Analytics</span>
          <h3>Auto Analytics Dashboard</h3>
          <p>Revenue, clients, funnel — auto-updated. No manual Excel reports.</p>
          <span class="card-price">from $500</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
        <article class="solution-catalog-card glass-card" data-category="bots" data-modal-title="Telegram Intake Bot" data-modal-body="<p>Receives requests, routes to managers, logs to CRM.</p><p>24/7 intake via Telegram. Automatically categorizes and assigns. Integrates with your CRM.</p>" data-modal-price="from $500">
          <span class="card-icon">🤝</span>
          <span class="card-category">Bots</span>
          <h3>Telegram Intake Bot</h3>
          <p>Receives requests, routes to managers, logs to CRM. 24/7 intake via Telegram.</p>
          <span class="card-price">from $500</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
        <article class="solution-catalog-card glass-card" data-category="integrations" data-modal-title="CRM + Messenger Integration" data-modal-body="<p>Connect your CRM with Telegram, WhatsApp, or other messengers.</p><p>Two-way sync. Messages from clients appear in CRM. CRM updates push to messengers. No manual copy-paste.</p>" data-modal-price="from $500">
          <span class="card-icon">🔌</span>
          <span class="card-category">Integrations</span>
          <h3>CRM + Messenger Integration</h3>
          <p>Connect CRM with Telegram, WhatsApp. Two-way sync, no manual copy-paste.</p>
          <span class="card-price">from $500</span>
          <button type="button" class="btn-secondary modal-trigger">Learn More</button>
        </article>
      </div>
    </section>

    <section id="solutions-cta" aria-label="Custom build CTA">
      <h2>Don't see what you need?</h2>
      <p>We'll build it for you.</p>
      <a href="/quiz.html" class="btn-primary">Get a Free Prototype</a>
    </section>
  </main>

  <div class="modal-overlay" id="solution-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-body">
    <div class="modal-content">
      <button type="button" class="modal-close" aria-label="Close modal">&times;</button>
      <h3 id="modal-title"></h3>
      <div id="modal-body" class="modal-body"></div>
      <p class="modal-price" id="modal-price"></p>
    </div>
  </div>

  <%- include('partials/footer', { contactHref: '/#contact' }) %>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
