# Telegram — заявки с форм приходят в бота
# 1. Создай бота: @BotFather → /newbot → получи TELEGRAM_BOT_TOKEN
# 2. Узнай chat_id: напиши боту /start, затем открой:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Найди "chat":{"id":123456789} — это TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway: добавь эти переменные в Dashboard → Variables
